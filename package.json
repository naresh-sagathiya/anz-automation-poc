  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure": "^3.16.0",
    "allure-cucumberjs": "^3.11.0",
    "appium": "^2.5.4",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
