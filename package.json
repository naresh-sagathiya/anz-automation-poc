{
  "name": "anz-automation-poc",
  "version": "1.0.0",
  "description": "",
  "allowScripts": {
    "appium-uiautomator2-driver": true,
    "appium-chromium-driver": true
  },
  "main": "index.js",
  "scripts": {
    "test:api": "cucumber-js --profile api",
    "test:api:shard": "node scripts/run-api-shard.js",
    "test:api:lifecycle": "cross-env ACCESS_TOKEN_SECONDS=2 cucumber-js --profile api --tags @A3",
    "test:web": "cucumber-js --profile web",
    "test:mobile": "cucumber-js --profile mobile",
    "test:mobile:m14:report": "cucumber-js mobile/features/**/*.feature --require mobile/steps/**/*.ts --require mobile/support/**/*.ts --require-module tsx/cjs --tags @ID-M14 --format html:reports/mobile-idm14-report.html --format json:reports/mobile-idm14-report.json --publish-quiet",
    "test:mobile:parallel": "cucumber-js --profile mobile --parallel 2",
    "test:mobile:shard": "node scripts/run-mobile-shard.js",
    "test:mobile:devices": "cross-env \"MOBILE_DEVICES=iPad,iPhone 12,Pixel 5\" cucumber-js --profile mobile --parallel 3",
    "test:mobile:headed": "cross-env HEADLESS=false cucumber-js --profile mobile",
    "test:mobile:parallel:headed": "cross-env HEADLESS=false cucumber-js --profile mobile --parallel 2",
    "test:mobile:devices:headed": "cross-env HEADLESS=false \"MOBILE_DEVICES=iPad,iPhone 12,Pixel 5\" cucumber-js --profile mobile --parallel 3",
    "test:mobile:visual": "playwright test tests/mobile-visual-baselines.spec.ts --project=iPad --project=\"iPhone 12\" --project=\"iPhone 12 Pro Max\" --project=\"Pixel 5\" --project=\"Galaxy S9+\" --project=\"iPad Mini\"",
    "test:android": "cucumber-js --profile android",
    "test:android:abc": "cross-env ANDROID_APP_PATH=apps/ABCbank.apk ANDROID_DEVICE_NAME=sdk_gphone16k_x86_64 ANDROID_PLATFORM_VERSION=17 ANDROID_UDID=emulator-5554 ANDROID_APP_PACKAGE=com.app.hemanthbank ANDROID_APP_ACTIVITY=com.app.hemanthbank.MainActivity ANDROID_APP_WAIT_ACTIVITY=com.app.hemanthbank.MainActivity cucumber-js --profile android-abc",
    "test:android:abc:headed": "cross-env APPIUM_PORT=4735 HEADLESS=false ABC_KEEP_APP_OPEN=true npm run test:android:abc -- --tags @login",
    "allure:clean": "node -e \"const fs=require('fs'); ['allure-results','allure-report'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\"",
    "allure:generate": "allure generate ./allure-results --output allure-report",
    "allure:open": "allure open allure-report",
    "test:bs": "tsx mobile/tests/parabank-login.ts",
    "test:android:parallel": "tsx scripts/run-android-parallel.ts",
    "test:android:mybanking:parallel": "cross-env ANDROID_CUCUMBER_PROFILE=android-mybanking tsx scripts/run-android-parallel.ts",
    "test:android:fold": "cross-env ANDROID_DEVICE_NAME=Pixel_10_Pro_Fold ANDROID_PLATFORM_VERSION=16 cucumber-js --profile android",
    "test:android:pixel5": "cross-env ANDROID_DEVICE_NAME=Pixel_5 ANDROID_PLATFORM_VERSION=35 cucumber-js --profile android",
    "test:android:galaxy": "cross-env ANDROID_DEVICE_NAME=Galaxy_S9_Plus ANDROID_PLATFORM_VERSION=28 cucumber-js --profile android",
    "appium:start": "appium",
    "appium:start:android": "appium --allow-insecure=*:adb_shell",
    "appium:install-uiatomator2": "appium driver install uiautomator2",
    "start:locale:server": "node api/mock-server/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naresh-sagathiya/anz-automation-poc.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/naresh-sagathiya/anz-automation-poc/issues"
  },
  "homepage": "https://github.com/naresh-sagathiya/anz-automation-poc#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "allure": "^3.16.0",
    "allure-cucumberjs": "^3.11.0",
    "appium": "^3.7.0",
    "appium-chromium-driver": "^3.0.8",
    "appium-uiautomator2-driver": "^8.5.0",
    "cross-env": "^10.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.1",
    "webdriverio": "^9.15.1",
    "zod": "^4.5.0-canary.20260820T155656"
  }
}
