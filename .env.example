TEST_ENV=local

# Mobile web execution
MOBILE_BASE_URL=https://parabank.parasoft.com/parabank
PARABANK_USER=john
PARABANK_PASS=demo
MOBILE_DEVICES=iPad,iPhone 12,Pixel 5
HEADLESS=true

# ABC Bank native Appium execution (keep real values in local .env only)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4735
APPIUM_PATH=/
ANDROID_DEVICE_NAME=sdk_gphone16k_x86_64
ANDROID_PLATFORM_VERSION=17
ANDROID_UDID=emulator-5554
ABC_USERNAME=
ABC_PASSWORD=
ABC_TOTP_SECRET=

# Local API mock
API_BASE_URL=http://localhost:4010
API_USER_ALICE=alice
API_PASSWORD_ALICE=Password123!
API_USER_BOB=bob
API_PASSWORD_BOB=Password123!
API_USER_OPERATOR=operator
API_PASSWORD_OPERATOR=Operations123!

# Optional deployed environments
API_SIT_BASE_URL=https://sit.example.invalid/api
API_SIT_USER=
API_SIT_PASSWORD=
API_UAT_BASE_URL=https://uat.example.invalid/api
API_UAT_USER=
